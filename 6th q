print("Start small. Ship something.")
def knapsack_dp(wt,val,w):
    n=len(wt)
    dp=[[0]*(w + 1) for _ in range(n+1)]
    for i in range(1,n+1):
        for w in range(w + 1):
            if wt[i -1] <= w:
                take = val[i-1] + dp[i-1][w-wt[i-1]]
                skip = dp[i-1][w]
                dp[i][w]= max(take,skip)
            else:
                dp[i][w]= dp[i-1][w]
    return dp[n][w]
wt = [2,3,4,1]
val = [3,4,5,1,]
w=6
print(knapsack_dp(wt,val,w))
